# ─────────────────────────────────────────────
# Employee Management System — Environment File
# Copy to .env and fill in actual values
# ─────────────────────────────────────────────

# ── Required ──────────────────────────────────
JWT_SECRET=CHANGE_ME_to_a_long_random_secret_min_32_chars
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

# ── Optional (with defaults) ─────────────────
# MYSQL_DATABASE=employee
# MYSQL_USER=ems_user
# JWT_TTL_MS=3600000
# EPF_EMPLOYEE_PERCENT=8
# EPF_EMPLOYER_PERCENT=12
# CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173

# ── Docker Image Registry ────────────────────
# DOCKER_REGISTRY=ghcr.io/your-username
# IMAGE_TAG=latest

# ── Application Defaults ─────────────────────
# UPLOAD_DIR=/data/uploads
# MAX_FILE_SIZE=10MB
# MAX_REQUEST_SIZE=10MB
# JAVA_OPTS=-Xms256m -Xmx512m

# ── Default Admin (first-run only) ───────────
# CREATE_DEFAULT_USERS=true
# DEFAULT_ADMIN_USERNAME=admin@local
# DEFAULT_ADMIN_PASSWORD=secret
