# EMS Environment Configuration (managed by Ansible)
DOCKER_REGISTRY={{ docker_registry }}
IMAGE_TAG={{ image_tag }}

DB_URL={{ db_url }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}

MYSQL_DATABASE={{ db_name | default('employee') }}
MYSQL_USER={{ db_user }}
MYSQL_PASSWORD={{ db_password }}
MYSQL_ROOT_PASSWORD={{ db_password }}

JWT_SECRET={{ jwt_secret }}
JWT_TTL_MS={{ jwt_ttl_ms }}
EPF_EMPLOYEE_PERCENT={{ epf_employee_percent }}
EPF_EMPLOYER_PERCENT={{ epf_employer_percent }}

CORS_ALLOWED_ORIGIN_PATTERNS=*
